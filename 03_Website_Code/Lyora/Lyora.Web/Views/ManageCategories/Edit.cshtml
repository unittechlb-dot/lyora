@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit family";
}

<section class="container section">
    <partial name="_AdminNav" />
    <a class="link back-link" asp-action="Index">← All families</a>
    <div class="form-card">
        <span class="eyebrow">Perfume family</span>
        <h1>Edit family</h1>
        <form method="post" asp-action="Save" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
            <input type="hidden" asp-for="CategoryId" />
            <div class="field">
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Description"></label>
                <input asp-for="Description" />
                <span asp-validation-for="Description" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-dark btn-block">Save</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
