@model MaterialDetailsViewModel
@{
    var m = Model.Material;
    ViewData["Title"] = m.Name;
}

<section class="container section">
    <partial name="_AdminNav" />
    <a class="link back-link" asp-action="Index">← All raw materials</a>
    <div class="page-title title-row">
        <div>
            <span class="eyebrow">Raw material</span>
            <h1>@m.Name</h1>
        </div>
        <a class="btn btn-outline" asp-action="Edit" asp-route-id="@m.MaterialId">Edit details</a>
    </div>

    <div class="stat-grid">
        <div class="stat @(m.IsBelowThreshold ? "stat-alert" : "")">
            <span class="stat-label">In stock</span>
            <span class="stat-value">@m.QuantityInStock.ToString("#,0.##") <small>@m.Unit</small></span>
        </div>
        <div class="stat">
            <span class="stat-label">Low-stock threshold</span>
            <span class="stat-value">@m.Threshold.ToString("#,0.##") <small>@m.Unit</small></span>
        </div>
        <div class="stat">
            <span class="stat-label">Stock value</span>
            <span class="stat-value">@Format.Money(m.QuantityInStock * m.CostPerUnit)</span>
        </div>
    </div>

    <div class="admin-columns">
        <div class="panel">
            <h2>Restock</h2>
            <p class="muted small">Enter the quantity received from the supplier. It is added to the stock and saved in the history.</p>
            <form class="bom-form" method="post" asp-action="Restock" asp-route-id="@m.MaterialId">
                <input type="number" name="quantity" step="@(m.Unit == "pcs" ? "1" : "0.01")" min="0.01" placeholder="Received quantity (@m.Unit)" aria-label="Received quantity" required />
                <button type="submit" class="btn btn-gold">Add to stock</button>
            </form>
        </div>

        <div class="panel">
            <h2>Stock history</h2>
            @if (Model.Transactions.Count == 0)
            {
                <p class="muted">No movements yet.</p>
            }
            else
            {
                <table class="table">
                    <thead><tr><th>Date</th><th>Type</th><th>Order</th><th class="num">Change</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            <tr>
                                <td>@Format.Date(t.TransactionDate)</td>
                                <td>@(t.Type switch { TransactionType.Sale => "Sale", TransactionType.Restock => "Restock", _ => "Order cancelled" })</td>
                                <td>@if (t.OrderId != null) { <a class="link" asp-controller="ManageOrders" asp-action="Details" asp-route-id="@t.OrderId">#@t.OrderId</a> }</td>
                                <td class="num @(t.QuantityChange < 0 ? "low" : "gain")">@(t.QuantityChange > 0 ? "+" : "")@t.QuantityChange.ToString("#,0.##") @m.Unit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</section>
