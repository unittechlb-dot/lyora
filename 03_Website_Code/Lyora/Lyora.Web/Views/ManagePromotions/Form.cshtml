@model PromotionFormViewModel
@{
    var isNew = Model.PromotionId == 0;
    ViewData["Title"] = isNew ? "New promotion" : Model.Title;
}

<section class="container section">
    <partial name="_AdminNav" />
    <a class="link back-link" asp-action="Index">← All promotions</a>
    <div class="form-card form-card-wide">
        <span class="eyebrow">Promotion</span>
        <h1>@(isNew ? "New promotion" : "Edit promotion")</h1>

        <form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.PromotionId)" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
            <div class="form-grid">
                <div class="field field-full">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" placeholder="e.g. Royal Oud Offer" />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="DiscountPercent"></label>
                    <input asp-for="DiscountPercent" type="number" step="0.01" min="1" max="90" />
                    <span asp-validation-for="DiscountPercent" class="field-error"></span>
                </div>
                <div></div>
                <div class="field">
                    <label asp-for="StartDate"></label>
                    <input asp-for="StartDate" type="date" />
                </div>
                <div class="field">
                    <label asp-for="EndDate"></label>
                    <input asp-for="EndDate" type="date" />
                </div>
            </div>

            <fieldset class="perfume-picker">
                <legend>Perfumes in the promotion</legend>
                @foreach (var p in Model.AllPerfumes)
                {
                    <label class="pick">
                        <input type="checkbox" name="PerfumeIds" value="@p.PerfumeId" checked="@Model.PerfumeIds.Contains(p.PerfumeId)" />
                        <img src="@Format.Image(p.ImageUrl)" alt="" />
                        <span>@p.Name<br /><small class="muted">@Format.Money(p.Price)@(p.IsActive ? "" : " · hidden")</small></span>
                    </label>
                }
            </fieldset>

            <div class="form-actions">
                <button type="submit" class="btn btn-dark">@(isNew ? "Create promotion" : "Save")</button>
            </div>
        </form>

        @if (!isNew)
        {
            <form class="delete-form" method="post" asp-action="Delete" asp-route-id="@Model.PromotionId"
                  onsubmit="return confirm('Delete this promotion? Prices go back to normal.');">
                <button type="submit" class="btn btn-danger">Delete promotion</button>
            </form>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
