@using System.Security.Claims
@using Lyora.BLL.Services
@inject CartService CartService

@if (User.Identity?.IsAuthenticated == true)
{
    @if (User.IsInRole(Roles.Administrator))
    {
        <a asp-controller="Admin" asp-action="Index">Dashboard</a>
    }
    else
    {
        <a asp-controller="Orders" asp-action="Index">My orders</a>
        <a asp-controller="Account" asp-action="Profile">My account</a>
        <a class="cart-link" asp-controller="Cart" asp-action="Index" aria-label="Shopping cart">
            Cart
            @{ var bottles = CartService.CountBottles(int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!)); }
            @if (bottles > 0)
            {
                <span class="cart-count">@bottles</span>
            }
        </a>
    }
    <form class="logout-form" method="post" asp-controller="Account" asp-action="Logout">
        <button type="submit" class="nav-button">Logout</button>
    </form>
}
else
{
    <a asp-controller="Account" asp-action="Login">Login</a>
    <a class="nav-cta" asp-controller="Account" asp-action="Register">Register</a>
}
