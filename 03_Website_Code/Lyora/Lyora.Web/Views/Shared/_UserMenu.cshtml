@using System.Security.Claims
@using Lyora.BLL.Services
@inject CartService CartService
@inject NotificationService NotificationService

@if (User.Identity?.IsAuthenticated == true)
{
    @if (User.IsInRole(Roles.Administrator))
    {
        <a asp-controller="Admin" asp-action="Index">Dashboard</a>
    }
    else
    {
        <a asp-controller="Orders" asp-action="Index">My orders</a>
        <a asp-controller="Account" asp-action="Profile">My account</a>
        <a class="cart-link" asp-controller="Cart" asp-action="Index" aria-label="Shopping cart">
            Cart
            @{ var bottles = CartService.CountBottles(int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!)); }
            @if (bottles > 0)
            {
                <span class="cart-count">@bottles</span>
            }
        </a>
    }
    var unread = NotificationService.CountUnread(int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!));
    <a class="bell-link" asp-controller="Notifications" asp-action="Index" aria-label="Notifications@(unread > 0 ? $", {unread} unread" : "")">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z" fill="currentColor"/></svg>
        @if (unread > 0)
        {
            <span class="cart-count">@(unread > 99 ? "99+" : unread.ToString())</span>
        }
    </a>
    <form class="logout-form" method="post" asp-controller="Account" asp-action="Logout">
        <button type="submit" class="nav-button">Logout</button>
    </form>
}
else
{
    <a asp-controller="Account" asp-action="Login">Login</a>
    <a class="nav-cta" asp-controller="Account" asp-action="Register">Register</a>
}
