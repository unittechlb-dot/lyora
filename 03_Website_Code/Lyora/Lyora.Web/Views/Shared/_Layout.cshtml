<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – LYORA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" asp-controller="Home" asp-action="Index">LYORA</a>
            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Perfumes" asp-action="Index">Perfumes</a>
                <partial name="_UserMenu" />
            </nav>
        </div>
    </header>

    <main>
        @if (TempData["Success"] is string success)
        {
            <div class="container">
                <div class="alert alert-success" role="status">@success</div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="container">
                <div class="alert alert-error" role="alert">@error</div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <span class="logo logo-small">LYORA</span>
            <span>Smart Luxury Perfume MIS · University of Tripoli – Lebanon · @DateTime.Now.Year</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
