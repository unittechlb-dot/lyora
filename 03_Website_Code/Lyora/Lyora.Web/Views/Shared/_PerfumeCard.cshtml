@model Perfume

<a class="perfume-card" asp-controller="Perfumes" asp-action="Details" asp-route-id="@Model.PerfumeId">
    <div class="perfume-image">
        <img src="@Format.Image(Model.ImageUrl)" alt="@Model.Name" loading="lazy" />
        @if (!Model.IsAvailable)
        {
            <span class="badge badge-out">Out of stock</span>
        }
        @if (Model.HasDiscount)
        {
            <span class="badge badge-sale">−@Model.DiscountPercent.ToString("0.##")%</span>
        }
    </div>
    <div class="perfume-info">
        <span class="eyebrow">@Model.CategoryName</span>
        <h3>@Model.Name</h3>
        <div class="tags">
            <span class="tag">@Model.Intensity</span>
            <span class="tag">@Model.Style</span>
            <span class="tag">@Model.SizeMl ml</span>
        </div>
        <partial name="_Price" model="Model" />
    </div>
</a>
