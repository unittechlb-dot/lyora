@model List<Order>
@{
    ViewData["Title"] = "My orders";
}

<section class="container section">
    <div class="page-title">
        <span class="eyebrow">My account</span>
        <h1>My orders</h1>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty panel">
            <h3>You have no orders yet.</h3>
            <a class="btn btn-gold" asp-controller="Perfumes" asp-action="Index">Explore perfumes</a>
        </div>
    }
    else
    {
        <div class="panel">
            <table class="table">
                <thead>
                    <tr><th>Order</th><th>Date</th><th>Bottles</th><th>Status</th><th class="num">Total</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td><strong>#@o.OrderId</strong></td>
                            <td>@Format.Date(o.OrderDate)</td>
                            <td>@o.Bottles</td>
                            <td><span class="status status-@o.Status.ToString().ToLowerInvariant()">@Format.Status(o.Status)</span></td>
                            <td class="num">@Format.Money(o.TotalAmount)</td>
                            <td class="num"><a class="link" asp-action="Details" asp-route-id="@o.OrderId">Details →</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
