@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container hero-inner">
        <div class="hero-text">
            <span class="eyebrow">Luxury fragrance house</span>
            <h1>A perfume that feels like you.</h1>
            <p>Discover LYORA perfumes, crafted from natural raw materials and matched to your taste.</p>
            <div class="hero-actions">
                <a class="btn btn-gold" asp-controller="Perfumes" asp-action="Index">Explore perfumes</a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="btn btn-ghost" asp-controller="Account" asp-action="Register">Join LYORA</a>
                }
            </div>
        </div>
        <div class="hero-art">
            <img src="~/images/hero-bottles.svg" alt="LYORA perfume bottles on gold podiums" />
        </div>
    </div>
</section>

<section class="container section">
    <div class="section-head">
        <h2>Featured perfumes</h2>
        <a class="link" asp-controller="Perfumes" asp-action="Index">View all →</a>
    </div>
    <div class="perfume-grid">
        @foreach (var perfume in Model.Featured)
        {
            <partial name="_PerfumeCard" model="perfume" />
        }
    </div>
</section>

@if (!User.IsInRole(Roles.Administrator))
{
    <section class="container">
        <div class="quiz-banner">
            <div>
                <span class="eyebrow">Find my scent</span>
                <h2>Not sure which perfume to choose?</h2>
                <p>Answer 8 quick questions about what you like – we hide anything you are allergic to and suggest the perfumes that fit you best.</p>
            </div>
            <a class="btn btn-gold" asp-controller="Questionnaire" asp-action="Index">Take the questionnaire</a>
        </div>
    </section>
}

<section class="container section">
    <div class="section-head">
        <h2>Shop by family</h2>
    </div>
    <div class="category-grid">
        @foreach (var category in Model.Categories)
        {
            <a class="category-card" asp-controller="Perfumes" asp-action="Index" asp-route-categoryId="@category.CategoryId">
                <img class="category-icon" src="@Format.FamilyImage(category.Name)" alt="" />
                <h3>@category.Name</h3>
                <p>@category.Description</p>
            </a>
        }
    </div>
</section>
