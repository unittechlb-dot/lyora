@model PerfumeDetailsViewModel
@{
    var p = Model.Perfume;
    ViewData["Title"] = p.Name;
}

<section class="container section">
    <a class="link back-link" asp-action="Index">← Back to perfumes</a>

    <div class="details">
        <div class="details-image">
            <img src="@Format.Image(p.ImageUrl)" alt="@p.Name" />
        </div>

        <div class="details-info">
            <span class="eyebrow">@p.CategoryName</span>
            <h1>@p.Name</h1>
            <p class="details-price">
                @Format.Money(p.FinalPrice)
                @if (p.HasDiscount)
                {
                    <s class="old-price">@Format.Money(p.Price)</s>
                    <span class="badge badge-sale-inline">−@p.DiscountPercent.ToString("0.##")%</span>
                }
                <span>· @p.SizeMl ml</span>
            </p>
            <p class="details-description">@p.Description</p>

            <div class="tags">
                <span class="tag">@p.Intensity scent</span>
                <span class="tag">@p.Style style</span>
            </div>

            <p class="stock @(p.IsAvailable ? "stock-in" : "stock-out")">
                @(p.IsAvailable ? "In stock" : "Out of stock – raw materials are being restocked")
            </p>

            @if (p.IsAvailable)
            {
                @if (User.IsInRole(Roles.Customer))
                {
                    var max = Math.Min(Lyora.BLL.Services.CartService.MaxBottlesPerPerfume, p.ProducibleBottles);
                    <form class="add-to-cart" method="post" asp-controller="Cart" asp-action="Add">
                        <input type="hidden" name="perfumeId" value="@p.PerfumeId" />
                        <label for="quantity" class="sr-only">Quantity</label>
                        <select id="quantity" name="quantity">
                            @for (var q = 1; q <= max; q++)
                            {
                                <option value="@q">@q</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-gold">Add to cart</button>
                    </form>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="btn btn-dark add-to-cart-login" asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Details", "Perfumes", new { id = p.PerfumeId })">Login to order</a>
                }
            }

            <h2 class="ingredients-title">Ingredients</h2>
            <ul class="ingredients">
                @foreach (var item in Model.Ingredients)
                {
                    <li>
                        @item.MaterialName
                        @if (item.IsAllergen)
                        {
                            <span class="badge badge-allergen">Allergen</span>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
</section>
