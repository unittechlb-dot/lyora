@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<section class="container section">
    <div class="form-card">
        <span class="eyebrow">Security</span>
        <h1>Change password</h1>

        <form method="post" asp-action="ChangePassword" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

            <div class="field">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" autocomplete="new-password" />
                <span class="hint">At least 8 characters, with letters and numbers.</span>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-dark btn-block">Change password</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
