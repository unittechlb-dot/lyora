@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="container section">
    <div class="form-card form-card-wide">
        <span class="eyebrow">Join LYORA</span>
        <h1>Create your account</h1>

        <form method="post" asp-action="Register" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

            <div class="form-grid">
                <div class="field">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" autocomplete="name" />
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Phone"></label>
                    <input asp-for="Phone" autocomplete="tel" placeholder="+961 70 000 000" />
                    <span asp-validation-for="Phone" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="DateOfBirth"></label>
                    <input asp-for="DateOfBirth" />
                    <span asp-validation-for="DateOfBirth" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Gender"></label>
                    <select asp-for="Gender">
                        <option value="">Prefer not to say</option>
                        <option value="Female">Female</option>
                        <option value="Male">Male</option>
                    </select>
                    <span asp-validation-for="Gender" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Address"></label>
                    <input asp-for="Address" autocomplete="street-address" />
                    <span asp-validation-for="Address" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="new-password" />
                    <span class="hint">At least 8 characters, with letters and numbers.</span>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-gold btn-block">Create account</button>
        </form>

        <p class="form-footer">Already have an account? <a class="link" asp-action="Login">Login</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
